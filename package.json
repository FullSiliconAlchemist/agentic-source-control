{
  "name": "quickstart-template",
  "version": "1.0.0",
  "private": true,
  "bin": { "assure": "packages/api/bin/assure.cjs" },
  "scripts": {
    "assure": "node packages/api/bin/assure.cjs",
    "acceptance:report": "pnpm --filter @quickstart-template/api acceptance:report",
    "analyze-pr": "pnpm --filter @quickstart-template/api analyze-pr",
    "fetch-pr": "pnpm --filter @quickstart-template/api fetch-pr",
    "demo:report": "pnpm --filter @quickstart-template/api demo:report",
    "dev:api": "pnpm --filter @quickstart-template/api dev",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "build:api": "pnpm --filter @quickstart-template/api build"
  },
  "engines": {
    "node": ">=24.22.3",
    "pnpm": ">=10"
  }
}
